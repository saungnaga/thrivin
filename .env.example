# Scalev Checkout Configuration
# Set these as Environment Variables (Vercel), never in source.
SCALEV_API_KEY=sk_xxxxxxxxxxxx
SCALEV_STORE_ID=store_ius5tpSzfbS8SlB8GTjdGaBA
SCALEV_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# F-W4-1c: key TERPISAH least-privilege untuk cancel order saat TTL retire
# (`POST /v3/orders/change-status`, scope `order:change_status` saja). JANGAN
# memakai SCALEV_API_KEY di sini, dan jangan menambah scope cancel ke key
# webhook/create-order. Selama key ini kosong, cancel TIDAK aktif dan checkout
# tetap fail-closed saat ada order basi (keputusan owner, 2026-10-17).
SCALEV_CANCEL_API_KEY=sk_cancel_xxxxxxxxxxxx

# Meta Pixel Configuration
NEXT_PUBLIC_META_PIXEL_ID=1130657963058730

# WA-first identity: sesi pelanggan (TERPISAH dari sesi admin)
# `openssl rand -base64 32` untuk tiap secret. Naikkan WA_SESSION_EPOCH untuk
# mencabut semua sesi pelanggan sekaligus.
WA_SESSION_SECRET=changeme-openssl-rand-base64-32
WA_SESSION_EPOCH=0

# WA-first identity: OTP
# Hanya 'mock' (tanpa outbound) yang diimplementasikan; selain itu / kosong =
# pengiriman DITOLAK (gagal-tertutup). Nilai 'mock' SENGAJA tidak dikirim aktif
# di sini: mock juga ditolak saat NODE_ENV=production, dan harness yang butuh
# mock di build produksi harus menyalakannya eksplisit
# (WA_OTP_MOCK_ALLOW_IN_PRODUCTION=1). Provider nyata menunggu keputusan owner +
# review Sentinel.
WA_OTP_SECRET=changeme-openssl-rand-base64-32
# WA_OTP_PROVIDER=mock
# WA_OTP_MOCK_ALLOW_IN_PRODUCTION=1   # HANYA harness lokal, jangan di produksi
# WA_OTP_MOCK_SINK=/tmp/thrivin-otp-sink.jsonl   # di luar repo; file dibuat 0600
# WA_OTP_TTL_SECONDS=300
# WA_OTP_MIN_INTERVAL_SECONDS=60
# WA_OTP_MAX_PER_HOUR=5
