# Scalev Checkout Configuration
# Set these as Environment Variables (Vercel), never in source.
SCALEV_API_KEY=sk_xxxxxxxxxxxx
SCALEV_STORE_ID=store_ius5tpSzfbS8SlB8GTjdGaBA
SCALEV_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# F-W4-1c: key TERPISAH least-privilege untuk cancel order saat TTL retire
# (`POST /v3/orders/change-status`, scope `order:change_status` saja). JANGAN
# memakai SCALEV_API_KEY di sini, dan jangan menambah scope cancel ke key
# webhook/create-order. Selama key ini kosong, cancel TIDAK aktif dan checkout
# tetap fail-closed saat ada order basi (keputusan owner, 2026-10-17).
SCALEV_CANCEL_API_KEY=sk_cancel_xxxxxxxxxxxx

# Meta Pixel Configuration
NEXT_PUBLIC_META_PIXEL_ID=1130657963058730

# Nina pascabayar (kartu t_ef348cbc): outbound pembelian/pascabayar HANYA lewat
# WhatsApp Cloud API nomor resmi Meta (6285165581209). JANGAN isi
# WHATSAPP_BRIDGE_URL untuk jalur ini — kode tidak membacanya lagi.
# phone-number-id + token WAJIB berpasangan; salah satu kosong = pesan gagal
# (dicatat di log), bukan dialihkan ke nomor lama.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_API_VERSION=v21.0
# Template sapaan yang SUDAH APPROVED di Meta (dipakai kalau jendela 24 jam
# pelanggan sudah tutup). Kosong = outbound dicatat gagal, TIDAK fallback.
# WHATSAPP_CLOUD_WELCOME_TEMPLATE=welcome_thrivin
# WHATSAPP_CLOUD_WELCOME_TEMPLATE_LANG=id
# WHATSAPP_CLOUD_WELCOME_TEMPLATE_PARAMS=0
# Nomor yang ditampilkan di halaman sukses (default: nomor resmi di atas).
# NINA_WA_NUMBER=6285165581209
# Storefront API key untuk membaca redirect_url kanonik order (Scalev docs
# "Creating Orders" §5). Kosong = checkout tetap pakai payment_url.
# SCALEV_STOREFRONT_API_KEY=

# WA-first identity: sesi pelanggan (TERPISAH dari sesi admin)
# `openssl rand -base64 32` untuk tiap secret. Naikkan WA_SESSION_EPOCH untuk
# mencabut semua sesi pelanggan sekaligus.
WA_SESSION_SECRET=changeme-openssl-rand-base64-32
WA_SESSION_EPOCH=0

# WA-first identity: OTP — DEPRECATED (keputusan owner 20/10: TANPA OTP).
# Alur sekarang cuma lookup status nomor ke DB (`/api/wa/session/request`),
# jadi tidak ada kode yang dikirim dan tidak ada yang membaca variabel di bawah.
# Dibiarkan supaya `.env` produksi yang masih memuatnya tidak pecah; aman
# dihapus kapan saja. Kode `src/lib/otp*.ts` juga tinggal sebagai referensi
# (tidak dipanggil route mana pun).
# WA_OTP_SECRET=changeme-openssl-rand-base64-32
# WA_OTP_PROVIDER=mock
# WA_OTP_MOCK_ALLOW_IN_PRODUCTION=1   # HANYA harness lokal, jangan di produksi
# WA_OTP_MOCK_SINK=/tmp/thrivin-otp-sink.jsonl   # di luar repo; file dibuat 0600
# WA_OTP_TTL_SECONDS=300
# WA_OTP_MIN_INTERVAL_SECONDS=60
# WA_OTP_MAX_PER_HOUR=5
